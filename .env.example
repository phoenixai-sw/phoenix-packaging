APP_ENV=development
DATABASE_URL=sqlite:///.data/phoenix.db
STORAGE_BACKEND=local
STORAGE_DIR=.data/storage
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
DEMO_MODE=true
WORKER_SECRET=replace-with-a-random-local-secret
API_ORIGIN=http://127.0.0.1:8000
# Hosted staging uses Supabase PostgreSQL transaction pooler and private Storage.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@POOLER:6543/postgres?sslmode=require
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=server-only-secret
# SUPABASE_STORAGE_BUCKET=phoenix-private
# SUPABASE_UPLOAD_BUCKET=phoenix-private-uploads

APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
# Comma-separated verified Google emails allowed to operate the platform.
ADMIN_EMAILS=
AI_PROVIDER=fixture
IMAGE_MODEL=gpt-image-2.5-sunburst
# Allowed selectable models. IMAGE_MODEL remains the default, not a job override.
AI_IMAGE_MODELS=gpt-image-2.5-sunburst,gpt-image-2.5-flare
OPENAI_API_KEY=
AI_DAILY_UNIT_LIMIT=30
AI_DAILY_COST_LIMIT_USD=10
AI_REQUEST_ALLOWANCE_USD=2
AI_MONTHLY_BUDGET_ALERT_USD=100
AI_HIGH_ENABLED=false
# Enables xhigh/max/auto generation and editing; each uses the 20-credit tier.
AI_REQUIRE_VERIFIED_EMAIL=true
AI_ALLOWED_EMAILS=
PAYMENT_PROVIDER=disabled
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_MERCHANT_ID=
BILLING_ENCRYPTION_KEY=
BILLING_POLICY_APPROVED=false
LIVE_BILLING_ENABLED=false
ENABLE_PRODUCTION_EXPORT=false
OPERATING_POLICY_APPROVED=false
