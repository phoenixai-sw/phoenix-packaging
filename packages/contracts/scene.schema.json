{
  "$defs": {
    "Face": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "front",
            "back",
            "bottom",
            "left",
            "right",
            "top"
          ],
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 30,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "width_mm": {
          "maximum": 800,
          "minimum": 20,
          "title": "Width Mm",
          "type": "number"
        },
        "height_mm": {
          "maximum": 800,
          "minimum": 20,
          "title": "Height Mm",
          "type": "number"
        },
        "background": {
          "default": "#F5F0E6",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Background",
          "type": "string"
        },
        "objects": {
          "items": {
            "$ref": "#/$defs/SceneObject"
          },
          "maxItems": 200,
          "title": "Objects",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "width_mm",
        "height_mm"
      ],
      "title": "Face",
      "type": "object"
    },
    "Hole": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Id",
          "type": "string"
        },
        "face_id": {
          "enum": [
            "front",
            "back",
            "bottom",
            "left",
            "right",
            "top"
          ],
          "title": "Face Id",
          "type": "string"
        },
        "center_x_mm": {
          "maximum": 2000,
          "minimum": -2000,
          "title": "Center X Mm",
          "type": "number"
        },
        "center_y_mm": {
          "maximum": 2000,
          "minimum": -2000,
          "title": "Center Y Mm",
          "type": "number"
        },
        "diameter_mm": {
          "maximum": 10,
          "minimum": 4,
          "title": "Diameter Mm",
          "type": "number"
        }
      },
      "required": [
        "id",
        "face_id",
        "center_x_mm",
        "center_y_mm",
        "diameter_mm"
      ],
      "title": "Hole",
      "type": "object"
    },
    "ImageCrop": {
      "additionalProperties": false,
      "description": "Normalized EXIF-oriented source coordinates; placement bbox stays unchanged.",
      "properties": {
        "x": {
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "width": {
          "maximum": 1,
          "minimum": 1e-06,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "maximum": 1,
          "minimum": 1e-06,
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "ImageCrop",
      "type": "object"
    },
    "PouchFeatures": {
      "additionalProperties": false,
      "description": "Optional physical pouch finishing, measured down from the top cut edge.",
      "properties": {
        "header_height_mm": {
          "default": 30,
          "maximum": 100,
          "minimum": 20,
          "title": "Header Height Mm",
          "type": "number"
        },
        "zipper_enabled": {
          "default": true,
          "title": "Zipper Enabled",
          "type": "boolean"
        },
        "zipper_y_mm": {
          "default": 35,
          "maximum": 200,
          "minimum": 10,
          "title": "Zipper Y Mm",
          "type": "number"
        },
        "zipper_band_mm": {
          "default": 6,
          "maximum": 15,
          "minimum": 2,
          "title": "Zipper Band Mm",
          "type": "number"
        },
        "tear_enabled": {
          "default": true,
          "title": "Tear Enabled",
          "type": "boolean"
        },
        "tear_y_mm": {
          "default": 24,
          "maximum": 100,
          "minimum": 12,
          "title": "Tear Y Mm",
          "type": "number"
        },
        "notch_depth_mm": {
          "default": 3,
          "maximum": 5,
          "minimum": 1,
          "title": "Notch Depth Mm",
          "type": "number"
        },
        "notch_height_mm": {
          "default": 4,
          "maximum": 8,
          "minimum": 2,
          "title": "Notch Height Mm",
          "type": "number"
        },
        "notch_shape": {
          "default": "round",
          "enum": [
            "round",
            "v"
          ],
          "title": "Notch Shape",
          "type": "string"
        }
      },
      "title": "PouchFeatures",
      "type": "object"
    },
    "SceneObject": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "text",
            "image",
            "shape",
            "barcode"
          ],
          "title": "Type",
          "type": "string"
        },
        "face_id": {
          "enum": [
            "front",
            "back",
            "bottom",
            "left",
            "right",
            "top"
          ],
          "title": "Face Id",
          "type": "string"
        },
        "x_mm": {
          "maximum": 2000,
          "minimum": -2000,
          "title": "X Mm",
          "type": "number"
        },
        "y_mm": {
          "maximum": 2000,
          "minimum": -2000,
          "title": "Y Mm",
          "type": "number"
        },
        "width_mm": {
          "exclusiveMinimum": 0,
          "maximum": 2000,
          "title": "Width Mm",
          "type": "number"
        },
        "height_mm": {
          "exclusiveMinimum": 0,
          "maximum": 2000,
          "title": "Height Mm",
          "type": "number"
        },
        "rotation_deg": {
          "default": 0,
          "maximum": 360,
          "minimum": -360,
          "title": "Rotation Deg",
          "type": "number"
        },
        "z_index": {
          "default": 0,
          "maximum": 10000,
          "minimum": -10000,
          "title": "Z Index",
          "type": "integer"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 12000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "font_size_pt": {
          "anyOf": [
            {
              "maximum": 400,
              "minimum": 4,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Font Size Pt"
        },
        "font_id": {
          "anyOf": [
            {
              "const": "NotoSansKR",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Font Id"
        },
        "font_weight": {
          "default": 400,
          "maximum": 1000,
          "minimum": 1,
          "title": "Font Weight",
          "type": "integer"
        },
        "font_asset_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Font Asset Id"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "align": {
          "anyOf": [
            {
              "enum": [
                "left",
                "center",
                "right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Align"
        },
        "asset_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "crop": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImageCrop"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        },
        "print_enabled": {
          "default": true,
          "title": "Print Enabled",
          "type": "boolean"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "opacity": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Opacity",
          "type": "number"
        },
        "line_height": {
          "anyOf": [
            {
              "maximum": 4,
              "minimum": 0.5,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Height"
        },
        "letter_spacing": {
          "anyOf": [
            {
              "maximum": 30,
              "minimum": -5,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Letter Spacing"
        },
        "binding_key": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Binding Key"
        },
        "fill": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fill"
        },
        "stroke": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stroke"
        },
        "stroke_width_mm": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stroke Width Mm"
        },
        "shape": {
          "anyOf": [
            {
              "enum": [
                "rect",
                "ellipse",
                "circle"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shape"
        },
        "barcode_value": {
          "anyOf": [
            {
              "pattern": "^[0-9]{13}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Barcode Value"
        },
        "module_mm": {
          "anyOf": [
            {
              "maximum": 0.66,
              "minimum": 0.264,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Module Mm"
        },
        "bar_height_mm": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 18.28,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bar Height Mm"
        },
        "barcode_owned": {
          "default": false,
          "title": "Barcode Owned",
          "type": "boolean"
        },
        "barcode_usage": {
          "default": "retail",
          "enum": [
            "retail",
            "sample"
          ],
          "title": "Barcode Usage",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "face_id",
        "x_mm",
        "y_mm",
        "width_mm",
        "height_mm"
      ],
      "title": "SceneObject",
      "type": "object"
    },
    "StructureRef": {
      "additionalProperties": false,
      "properties": {
        "template_version_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Template Version Id",
          "type": "string"
        },
        "definition_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Definition Hash",
          "type": "string"
        },
        "engine_version": {
          "const": "structure-v2.1",
          "title": "Engine Version",
          "type": "string"
        },
        "geometry_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Geometry Hash",
          "type": "string"
        }
      },
      "required": [
        "template_version_id",
        "definition_hash",
        "engine_version",
        "geometry_hash"
      ],
      "title": "StructureRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "template_version_id": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Template Version Id"
    },
    "template_kind": {
      "anyOf": [
        {
          "enum": [
            "three-side-seal",
            "stand-up-pouch",
            "folding-box"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Template Kind"
    },
    "structure_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/StructureRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "bottom_mm": {
      "anyOf": [
        {
          "maximum": 180,
          "minimum": 30,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bottom Mm"
    },
    "depth_mm": {
      "anyOf": [
        {
          "maximum": 300,
          "minimum": 30,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Depth Mm"
    },
    "holes": {
      "items": {
        "$ref": "#/$defs/Hole"
      },
      "maxItems": 8,
      "title": "Holes",
      "type": "array"
    },
    "pouch_features": {
      "anyOf": [
        {
          "$ref": "#/$defs/PouchFeatures"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "confirmed_fields": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Confirmed Fields",
      "type": "array"
    },
    "reviewed_face_ids": {
      "items": {
        "enum": [
          "front",
          "back",
          "bottom",
          "left",
          "right",
          "top"
        ],
        "type": "string"
      },
      "maxItems": 6,
      "title": "Reviewed Face Ids",
      "type": "array"
    },
    "brand_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Brand Id"
    },
    "product_variant_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Product Variant Id"
    },
    "workspace_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workspace Id"
    },
    "geometry_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Geometry Hash"
    },
    "active_face_id": {
      "default": "front",
      "enum": [
        "front",
        "back",
        "bottom",
        "left",
        "right",
        "top"
      ],
      "title": "Active Face Id",
      "type": "string"
    },
    "faces": {
      "items": {
        "$ref": "#/$defs/Face"
      },
      "maxItems": 6,
      "minItems": 2,
      "title": "Faces",
      "type": "array"
    }
  },
  "required": [
    "faces"
  ],
  "title": "Scene",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phoenix-packaging.invalid/contracts/scene-1.0.schema.json"
}
